// Benchmark: Member Calls (Membermethoden)
// Tests the performance of instance method invocations

class Calculator {
    function Add(a, b) => a + b;
    function Multiply(a, b) => a * b;
}

function Main()
{
    let calc = new Calculator();
    let result = 0;
    for(let i = 0; i < 100000; i = i + 1) {
        result = calc.Add(result, 1);
    }
    return result;
}

Main();
