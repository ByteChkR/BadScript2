
let Assert = NUnit.Assert;


function Test_LogicAnd()
{
	Assert.IsTrue(true && true, "true && true");
	Assert.IsFalse(false && true, "false && true");
	Assert.IsFalse(true && false, "true && false");
	Assert.IsFalse(false && false, "false && false");
}

NUnit.AddTest(Test_LogicAnd, "Operator '&&' tests");

function Test_LogicAndShortCircuit()
{
	const value = null;
	Assert.IsFalse(value != null && value.SomeProperty == 10, "Short-circuit evaluation should prevent null reference");
}

NUnit.AddTest(Test_LogicAndShortCircuit, "Operator '&&' short-circuit evaluation tests");