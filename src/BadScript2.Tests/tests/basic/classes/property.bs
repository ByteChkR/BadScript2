let Assert = NUnit.Assert;

function Test()
{
	class C 
	{
		let num __counter = 0;
		const num Counter { get => __counter++; }
	}
	let c = new C();
	Assert.AreEqual(c.Counter, 0, "Counter first Invocation is not 0");
	Assert.AreEqual(c.Counter, 1, "Counter second Invocation is not 1");
}

NUnit.AddTest(Test, "Constant Field Backed Property");
function Test_WithSet()
{
	class C 
	{
		let num __counter = 0;
		let num Counter { get => __counter++; set => __counter = value; }
	}
	let c = new C();
	Assert.AreEqual(c.Counter, 0, "Counter first Invocation is not 0");
	Assert.AreEqual(c.Counter, 1, "Counter second Invocation is not 1");
	c.Counter = 10;
	Assert.AreEqual(c.Counter, 10, "Counter setter was not invoked");
	Assert.AreEqual(c.Counter, 11, "Counter increment does not work after setter was invoked");

}

NUnit.AddTest(Test_WithSet, "Field Backed Property");

function Test_WithCompiledFastAccessors()
{
	class C
	{
		let num __counter = 0;
		let num Counter { compiled fast get => __counter++; compiled fast set => __counter = value; }

		compiled fast function num Sum(num a!, num b!)
		{
			return a + b;
		}
	}

	let c = new C();
	Assert.AreEqual(c.Counter, 0, "Compiled fast getter first invocation is not 0");
	Assert.AreEqual(c.Counter, 1, "Compiled fast getter second invocation is not 1");
	c.Counter = 10;
	Assert.AreEqual(c.Counter, 10, "Compiled fast setter was not invoked");
	Assert.AreEqual(c.Counter, 11, "Compiled fast getter increment does not work after setter");
	Assert.AreEqual(c.Sum(5, 6), 11, "Compiled fast method syntax inside class is not working");
}

NUnit.AddTest(Test_WithCompiledFastAccessors, "Compiled Fast Property Accessors");

function Test_WithMixedAccessorCompileLevels()
{
	class C
	{
		let num __counter = 0;
		let num Counter { compiled get => __counter++; set => __counter = value; }
	}

	let c = new C();
	Assert.AreEqual(c.Counter, 0, "Mixed compile-level getter first invocation is not 0");
	Assert.AreEqual(c.Counter, 1, "Mixed compile-level getter second invocation is not 1");
	c.Counter = 10;
	Assert.AreEqual(c.Counter, 10, "Legacy setter in mixed compile-level property was not invoked");
	Assert.AreEqual(c.Counter, 11, "Mixed compile-level getter increment does not work after legacy setter");
}

NUnit.AddTest(Test_WithMixedAccessorCompileLevels, "Mixed Property Accessor Compile Levels");

